# ---------------------------------------------------------------------------
# UG Mall — production environment. Copy to .env and fill in.
#   cp .env.example .env && chmod 600 .env
# Generate secrets with:  openssl rand -base64 36
# ---------------------------------------------------------------------------
NODE_ENV=production
SHOP_NAME="UG Mall"

# Where all persistent data lives on the server (postgres, redis, storage, backups, logs)
SHOP_ROOT=/opt/shop

# Domains (point DNS A records at your public IP, or use a Cloudflare Tunnel)
SHOP_DOMAIN=shop.example.ug
ADMIN_DOMAIN=admin.shop.example.ug
STOREFRONT_URL=https://shop.example.ug
ADMIN_URL=https://admin.shop.example.ug
# Public API URL (used in payment callbacks and signed file links)
API_PUBLIC_URL=https://shop.example.ug/api
# Public media URL — Nginx serves ${SHOP_ROOT}/storage/{products,categories,brands,reviews} here
MEDIA_PUBLIC_URL=https://shop.example.ug/media

# Database / cache
POSTGRES_DB=shop
POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me-long-random
REDIS_PASSWORD=change-me-long-random

# App secrets (MUST be changed; the API refuses to start in production with defaults)
APP_SECRET=change-me-at-least-32-random-characters
PAYMENT_CALLBACK_SECRET=change-me-at-least-32-random-characters

# Storage: local (default, files on this server) or minio (S3 API on this server)
STORAGE_DRIVER=local
# For STORAGE_DRIVER=minio (docker compose --profile minio up -d):
S3_ENDPOINT=http://minio:9000
S3_BUCKET=shop
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_UPLOAD_BYTES=10485760

# Payments — Ssentezo Wallet (MTN MoMo + Airtel Money)
PAYMENT_MOBILE_MONEY_PROVIDER=ssentezo
SSENTEZO_ENV=sandbox           # sandbox | live
SSENTEZO_USERNAME=
SSENTEZO_PASSWORD=
PAYMENT_TIMEOUT_MINUTES=15     # unpaid MoMo orders are cancelled after this
CHECKOUT_RESERVATION_MINUTES=10

# WhatsApp Business Platform (Cloud API). Leave empty to log messages instead.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_USE_TEMPLATES=true
WHATSAPP_TEMPLATE_LANGUAGE=en

# First owner account (created by the seed script)
SEED_ADMIN_EMAIL=owner@shop.example.ug
SEED_ADMIN_PASSWORD=
SEED_SAMPLE_DATA=false

# Backups (scripts/backup.sh)
BACKUP_KEEP_DAYS=14
# Off-site: any rclone remote (e.g. a second server via SFTP, Backblaze, Google Drive)
BACKUP_RCLONE_REMOTE=
# Encrypts off-site archives with age/gpg symmetric passphrase
BACKUP_PASSPHRASE=

LOG_LEVEL=info
