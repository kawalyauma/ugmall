# Local development (pnpm dev). Copy to .env
NODE_ENV=development
DATABASE_URL=postgres://shop:shop@localhost:5432/shop
REDIS_URL=redis://localhost:6379
STORAGE_ROOT=../../storage
MEDIA_PUBLIC_URL=http://localhost:4000/media
SERVE_MEDIA=true
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_PUBLIC_URL=http://localhost:4000
# Simulated Mobile Money (auto-succeeds after a few seconds). Use "ssentezo" with sandbox credentials to test the real API.
PAYMENT_MOBILE_MONEY_PROVIDER=fake
PAYMENTS_FAKE_DELAY_MS=5000
LOG_LEVEL=info
