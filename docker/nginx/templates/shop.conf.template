# Rendered by the nginx image entrypoint (envsubst) from SHOP_DOMAIN / ADMIN_DOMAIN.

server {
  listen 80;
  # listen [::]:80;   # enable if the server has IPv6
  server_name ${SHOP_DOMAIN} www.${SHOP_DOMAIN} ${ADMIN_DOMAIN};
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

server {
  listen 443 ssl;
  # listen [::]:443 ssl;   # enable if the server has IPv6
  http2 on;
  server_name www.${SHOP_DOMAIN};
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  return 301 https://${SHOP_DOMAIN}$request_uri;
}

# ---------------------------------------------------------------- storefront
server {
  listen 443 ssl;
  # listen [::]:443 ssl;   # enable if the server has IPv6
  http2 on;
  server_name ${SHOP_DOMAIN};
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:SSL:10m;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Frame-Options SAMEORIGIN always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  set $next_upstream storefront:3000;
  resolver 127.0.0.11 valid=30s;
  include /etc/nginx/snippets.conf;
}

# --------------------------------------------------------------------- admin
server {
  listen 443 ssl;
  # listen [::]:443 ssl;   # enable if the server has IPv6
  http2 on;
  server_name ${ADMIN_DOMAIN};
  ssl_certificate /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Frame-Options DENY always;
  add_header X-Robots-Tag "noindex, nofollow" always;

  # Optional: only allow the shop's network / VPN to reach the admin.
  # allow 102.x.x.x/32;
  # deny all;

  set $next_upstream admin:3000;
  resolver 127.0.0.11 valid=30s;

  # Payment and WhatsApp webhooks are only accepted on the public shop domain.
  location /api/webhooks/ { return 404; }
  include /etc/nginx/snippets.conf;
}
